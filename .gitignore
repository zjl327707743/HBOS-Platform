.env
*.local
.DS_Store
logs/
tmp/
.frappe/
sites/
volumes/
backups/
node_modules/
frontend/*/dist/

# HBOS 门户前端构建副产物安全网:vite.config.js 会遮蔽 vite.config.ts(解析顺序 .js 优先于 .ts),
# *.tsbuildinfo 同理属于副产物,即使未来工具链回退也不允许提交
frontend/hbos-portal-web/vite.config.js
frontend/hbos-portal-web/*.tsbuildinfo
.venv/
__pycache__/
runtime/

# Local attendance exports and validation data must not be committed.
docs/data/*.xlsx
docs/data/*.xls
docs/data/*.csv

# 批量改部门:核对表与执行记录含真实员工姓名,禁止提交
apps/hb_attendance_app/hb_attendance_app/hbos_attendance/部门调整核对表_*.csv
apps/hb_attendance_app/hb_attendance_app/hbos_attendance/批量改部门_执行记录.md

# 考勤数据导出文件（含真实员工信息，禁止提交）
*.csv
*.xlsx
anomaly_list.json
feishu_records.json
.claude/launch.json

# 例外：App 翻译文件属于源码，必须提交
!apps/hb_attendance_app/hb_attendance_app/translations/*.csv
