# UI-only development (explicit opt-in; production must use frappe)
VITE_PORTAL_DATA_MODE=mock

# Asset and router base (default /).
VITE_BASE=/
# API base URL (default empty: same-origin /api, including the Vite proxy).
# For a separate origin, Session cookies and credentialed CORS must be configured.
VITE_FRAPPE_BASE_URL=

# Real hbos_portal bootstrap mode:
# VITE_PORTAL_DATA_MODE=frappe
# API requests stay on the Vite origin and are proxied to Frappe:
# VITE_FRAPPE_PROXY_TARGET=http://127.0.0.1:8080
# Desk / Attendance / Inventory pages navigate to the Frappe origin.
# If omitted: development follows the proxy target; production stays same-origin.
# LIMS /hbos/lims/* stays on the Portal origin:
# VITE_FRAPPE_APP_ORIGIN=http://127.0.0.1:8080
