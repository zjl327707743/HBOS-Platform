# UI-only development (default)
VITE_PORTAL_DATA_MODE=mock

# Real hbos_portal bootstrap mode:
# VITE_PORTAL_DATA_MODE=frappe
# API and Frappe app pages stay on the Vite origin (5178) and are proxied.
# Same-origin is required: Frappe sends X-Frame-Options: SAMEORIGIN, so the
# Portal cannot embed Frappe pages from a different origin.
# VITE_FRAPPE_PROXY_TARGET=http://127.0.0.1:8080

# Production asset base. Must be /hbos/ so Vite's dist/assets/ does not
# collide with Frappe's /assets/.
# VITE_BASE=/hbos/
