{
  "name": "hbos-portal-web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:contract": "node ../../scripts/portal/lims_frontend_contract.mjs",
    "test:unit": "VITE_PORTAL_DATA_MODE=frappe node --test tests/*.test.mjs",
    "dev:frappe": "VITE_PORTAL_DATA_MODE=frappe vite --port 5178 --strictPort",
    "build:mock": "VITE_PORTAL_DATA_MODE=mock vue-tsc -b && VITE_PORTAL_DATA_MODE=mock vite build --mode mock",
    "lint": "eslint src vite.config.ts",
    "test:mock-gate": "node ../../scripts/portal/mock_content_gate.mjs",
    "dev:mock": "VITE_PORTAL_DATA_MODE=mock vite --port 5193 --strictPort"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.12.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.5",
    "vue-tsc": "^3.0.6"
  }
}
