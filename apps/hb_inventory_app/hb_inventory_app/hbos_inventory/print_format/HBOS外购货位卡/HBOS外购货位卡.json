 "doctype": "Print Format",
 "font_size": 10,
 "html": "<style>\n@page { size: A4 portrait; margin: 14mm 14mm; }\n.hbos-card { font-family: SimSun, \"宋体\", serif; font-size: 10pt; color: #000; }\n.hbos-card h2 { text-align: center; font-size: 15pt; font-weight: bold; margin: 0 0 3px 0; }\n.hbos-card .subtitle { text-align: center; font-size: 9pt; margin-bottom: 3px; }\n.hbos-card table { width: 100%; border-collapse: collapse; table-layout: fixed; }\n.hbos-card td { border: 1px solid #000; padding: 3px 4px; vertical-align: middle; word-break: break-all; }\n.hbos-card td.c { text-align: center; }\n.hbos-card td.h { height: 8mm; }\n.hbos-card .remark { border: 1px solid #000; border-top: none; padding: 4px 4px 10mm 4px; }\n</style>\n{% set flow = hbos_batch_flow(doc.name) %}\n{% set sl = hbos_shelf_life_marks(doc.item) %}\n{% set rm = hbos_release_marks(doc.name) %}\n<div class=\"hbos-card\">\n  <h2>外购物料货位卡</h2>\n  <div class=\"subtitle\">Inventory Card of Outsourcing Materials</div>\n  <table>\n    <colgroup><col style=\"width:6.250%\"><col style=\"width:6.250%\"><col style=\"width:6.250%\"><col style=\"width:6.250%\"><col style=\"width:6.250%\"><col style=\"width:6.250%\"><col style=\"width:6.250%\"><col style=\"width:6.250%\"><col style=\"width:6.250%\"><col style=\"width:6.250%\"><col style=\"width:6.250%\"><col style=\"width:6.250%\"><col style=\"width:6.250%\"><col style=\"width:6.250%\"><col style=\"width:6.250%\"><col style=\"width:6.250%\"></colgroup>\n    <tr><td colspan=\"16\" style=\"text-align:right\">第（&nbsp;&nbsp;&nbsp;&nbsp;）页</td></tr>\n    <tr>\n      <td colspan=\"2\" class=\"c\">品&nbsp;名</td><td colspan=\"7\">{{ doc.item_name or \"\" }}</td>\n      <td colspan=\"3\" class=\"c\">物料代码</td><td colspan=\"4\">{{ doc.item or \"\" }}</td>\n    </tr>\n    <tr>\n      <td colspan=\"2\" class=\"c\">供货单位</td><td colspan=\"4\">{{ hbos_supplier_name(doc.name) }}</td>\n      <td class=\"c\">生产单位</td><td colspan=\"9\">{{ hbos_production_unit(doc.name) }}</td>\n    </tr>\n    <tr>\n      <td colspan=\"2\" class=\"c\">原厂批号</td><td colspan=\"4\">{{ doc.hbos_supplier_batch_no or hbos_blank() }}</td>\n      <td class=\"c\">包装规格</td><td colspan=\"4\">{{ hbos_packaging_spec(doc.name) }}</td>\n      <td colspan=\"3\" class=\"c\">数量/件数</td><td colspan=\"2\">{{ hbos_qty_with_count(doc.name) }}</td>\n    </tr>\n    <tr>\n      <td colspan=\"2\" class=\"c\" rowspan=\"2\">进厂批号</td><td colspan=\"3\" rowspan=\"2\">{{ doc.batch_id or \"\" }}</td>\n      <td colspan=\"2\" class=\"c\" rowspan=\"2\">复检期 {{ sl[0] }}<br>有效期 {{ sl[1] }}</td>\n      <td colspan=\"4\" rowspan=\"2\"></td>\n      <td colspan=\"3\" class=\"c\">经手人</td><td colspan=\"2\"></td>\n    </tr>\n    <tr><td colspan=\"3\" class=\"c\">复核人</td><td colspan=\"2\"></td></tr>\n    <tr>\n      <td rowspan=\"3\" class=\"c\">状态</td><td colspan=\"3\" class=\"c\">入库</td><td colspan=\"2\">{{ hbos_batch_date_cn(doc.name, 'in') }}</td>\n      <td rowspan=\"3\" class=\"c\">货位号</td><td colspan=\"9\" rowspan=\"3\">{{ hbos_batch_bins_html(doc.name) }}</td>\n    </tr>\n    <tr><td colspan=\"3\" class=\"c\">待检</td><td colspan=\"2\">{{ hbos_blank_date() }}</td></tr>\n    <tr><td colspan=\"3\" class=\"c\">放行 {{ rm[0] }}&nbsp;不放行 {{ rm[1] }}</td><td colspan=\"2\">{{ hbos_batch_date_cn(doc.name, 'release') }}</td></tr>\n    <tr>\n      <td colspan=\"3\" rowspan=\"2\" class=\"c\">日期</td><td rowspan=\"2\" class=\"c\">领料单位</td>\n      <td colspan=\"2\" rowspan=\"2\" class=\"c\">用途</td>\n      <td colspan=\"2\" class=\"c\">发出量</td><td colspan=\"5\" class=\"c\">结存量</td>\n      <td colspan=\"2\" rowspan=\"2\" class=\"c\">经手人</td><td rowspan=\"2\" class=\"c\">复核人</td>\n    </tr>\n    <tr><td class=\"c\">件数</td><td class=\"c\">数量（&nbsp;&nbsp;）</td><td colspan=\"2\" class=\"c\">件数</td><td colspan=\"3\" class=\"c\">数量（&nbsp;&nbsp;）</td></tr>\n{% for f in flow %}\n    <tr>\n      <td colspan=\"3\">{{ hbos_datetime_cn(f.date) }}</td><td></td><td colspan=\"2\"></td>\n      <td></td><td>{{ hbos_fmt_weight(f.out_qty) }}</td>\n      <td colspan=\"2\"></td><td colspan=\"3\">{{ hbos_fmt_weight(f.balance) }}</td>\n      <td colspan=\"2\"></td><td></td>\n    </tr>\n{% endfor %}\n{% for i in range(flow|length, 12) %}\n    <tr><td colspan=\"3\"></td><td></td><td colspan=\"2\"></td><td></td><td></td><td colspan=\"2\"></td><td colspan=\"3\"></td><td colspan=\"2\"></td><td></td></tr>\n{% endfor %}\n  </table>\n  <div class=\"remark\">备注：</div>\n</div>",
 "idx": 0,
