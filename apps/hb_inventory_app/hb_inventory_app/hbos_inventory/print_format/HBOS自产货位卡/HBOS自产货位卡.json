 "doctype": "Print Format",
 "font_size": 10,
 "html": "<style>\n@page { size: A4 portrait; margin: 14mm 14mm; }\n.hbos-card { font-family: SimSun, \"宋体\", serif; font-size: 10pt; color: #000; }\n.hbos-card h2 { text-align: center; font-size: 15pt; font-weight: bold; margin: 0 0 3px 0; }\n.hbos-card .subtitle { text-align: center; font-size: 9pt; margin-bottom: 3px; }\n.hbos-card .page-no { text-align: right; font-size: 9pt; margin-bottom: 5px; }\n.hbos-card table { width: 100%; border-collapse: collapse; table-layout: fixed; }\n.hbos-card td { border: 1px solid #000; padding: 3px 4px; vertical-align: middle; word-break: break-all; }\n.hbos-card td.c { text-align: center; }\n.hbos-card tr.flow td { height: 7.5mm; } /* 流水行（含空白待写行）。值与官方受控表一致（模板里 trHeight=425 twips = 7.5mm）。实测渲染出来约 8.7mm —— 因为 td 还有 3px 上下内边距，wkhtmltopdf 把它加在 height 之上；比官方略宽一点点，写字更宽裕，A4 仍是一页。注意：上一版这里写的是 `td.h { height: 8mm }` 但**没有任何单元格挂 class=\"h\"**，是死规则，流水行因此塌成 ~1.3mm。 */\n.hbos-card .remark { border: 1px solid #000; border-top: none; padding: 4px 4px 10mm 4px; }\n</style>\n{% set flow = hbos_batch_flow(doc.name) %}\n{% set sl = hbos_shelf_life_marks(doc.item) %}\n{% set rm = hbos_release_marks(doc.name) %}\n<div class=\"hbos-card\">\n  <h2>自产物料/产品货位卡</h2>\n  <div class=\"subtitle\">Inventory Card of Self-Produced Materials/Products</div>\n  <div class=\"page-no\">第（&nbsp;&nbsp;&nbsp;&nbsp;）页</div>\n  <table>\n    <colgroup><col style=\"width:8.333%\"><col style=\"width:8.333%\"><col style=\"width:8.333%\"><col style=\"width:8.333%\"><col style=\"width:8.333%\"><col style=\"width:8.333%\"><col style=\"width:8.333%\"><col style=\"width:8.333%\"><col style=\"width:8.333%\"><col style=\"width:8.333%\"><col style=\"width:8.333%\"><col style=\"width:8.333%\"></colgroup>\n    <tr>\n      <td colspan=\"3\" class=\"c\">品名</td><td colspan=\"4\">{{ doc.item_name or \"\" }}</td>\n      <td colspan=\"2\" class=\"c\">物料代码</td><td colspan=\"3\">{{ doc.item or \"\" }}</td>\n    </tr>\n    <tr>\n      <td colspan=\"3\" class=\"c\">生产车间</td><td colspan=\"4\">{{ hbos_item_workshop(doc.item) }}</td>\n      <td colspan=\"2\" class=\"c\">生产批号</td><td colspan=\"3\">{{ doc.batch_id or \"\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"c\">包装规格</td><td colspan=\"3\">{{ hbos_packaging_spec(doc.name) }}</td>\n      <td class=\"c\">件数</td><td colspan=\"2\">{{ hbos_packaging_count(doc.name) }}</td>\n      <td colspan=\"2\" class=\"c\">复检期 {{ sl[0] }}&nbsp;有效期 {{ sl[1] }}</td>\n      <td colspan=\"2\" class=\"c\">入库<br>经手人</td><td class=\"c\">入库<br>复核人</td>\n    </tr>\n    <tr>\n      <td class=\"c\">入库数量</td><td colspan=\"3\">{{ hbos_fmt_weight(hbos_batch_total_qty(doc.name)) }}</td>\n      <td class=\"c\">单位</td><td colspan=\"2\">{{ hbos_batch_uom(doc.name) }}</td>\n      <td colspan=\"2\"></td><td colspan=\"2\"></td><td></td>\n    </tr>\n    <tr>\n      <td colspan=\"2\" class=\"c\">入库</td><td colspan=\"3\">{{ hbos_batch_date_cn(doc.name, 'in') }}</td>\n      <td rowspan=\"3\" class=\"c\">货位号</td><td colspan=\"6\" rowspan=\"3\">{{ hbos_batch_bins_html(doc.name) }}</td>\n    </tr>\n    <tr>\n      <td colspan=\"2\" class=\"c\">待检</td><td colspan=\"3\">{{ hbos_blank_date() }}</td>\n    </tr>\n    <tr>\n      <td colspan=\"2\" class=\"c\">放行 {{ rm[0] }}&nbsp;&nbsp;不放行 {{ rm[1] }}</td>\n      <td colspan=\"3\">{{ hbos_batch_date_cn(doc.name, 'release') }}</td>\n    </tr>\n    <tr>\n      <td rowspan=\"2\" class=\"c\">日期</td><td colspan=\"4\" rowspan=\"2\" class=\"c\">去向</td>\n      <td colspan=\"2\" class=\"c\">发出量</td><td colspan=\"3\" class=\"c\">结存量</td>\n      <td rowspan=\"2\" class=\"c\">经手人</td><td rowspan=\"2\" class=\"c\">复核人</td>\n    </tr>\n    <tr><td class=\"c\">件数</td><td class=\"c\">数量</td><td class=\"c\">件数</td><td colspan=\"2\" class=\"c\">数量</td></tr>\n{% for f in flow %}\n    <tr class=\"flow\">\n      <td>{{ hbos_datetime_cn(f.date) }}</td><td colspan=\"4\"></td>\n      <td></td><td>{{ hbos_fmt_weight(f.out_qty) }}</td>\n      <td></td><td colspan=\"2\">{{ hbos_fmt_weight(f.balance) }}</td>\n      <td></td><td></td>\n    </tr>\n{% endfor %}\n{% for i in range(flow|length, 12) %}\n    <tr class=\"flow\"><td></td><td colspan=\"4\"></td><td></td><td></td><td></td><td colspan=\"2\"></td><td></td><td></td></tr>\n{% endfor %}\n  </table>\n  <div class=\"remark\">备注：</div>\n</div>",
 "idx": 0,
 "line_breaks": 0,
