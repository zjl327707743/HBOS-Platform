{
  "doctype": "DocType",
  "name": "HBOS Knowledge Reference",
  "module": "HB Knowledge",
  "engine": "InnoDB",
  "autoname": "field:reference_id",
  "field_order": [
    "reference_id",
    "actor_key",
    "publication_id",
    "reference_json",
    "publication_state",
    "consume_until"
  ],
  "fields": [
    {
      "fieldname": "reference_id",
