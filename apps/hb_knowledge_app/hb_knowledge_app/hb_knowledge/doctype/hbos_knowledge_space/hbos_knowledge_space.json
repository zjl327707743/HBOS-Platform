{
  "doctype": "DocType",
  "name": "HBOS Knowledge Space",
  "module": "HB Knowledge",
  "engine": "InnoDB",
  "autoname": "field:space_id",
  "field_order": [
    "space_id",
    "title",
    "required_role",
    "enabled",
    "maintenance_department",
    "maintenance_template",
    "template_json",
    "parent_space",
    "space_admission_json"
  ],
  "fields": [
    {
      "fieldname": "space_id",
      "fieldtype": "Data",
      "label": "Space Id",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Space Title"
    },
    {
      "fieldname": "required_role",
      "fieldtype": "Link",
      "label": "Required Role",
      "options": "Role",
      "reqd": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1"
    }
    ,
    {"fieldname":"maintenance_department","fieldtype":"Data","label":"维护资料部门","read_only":1},
    {"fieldname":"maintenance_template","fieldtype":"Select","label":"默认资料模板","options":"auto\ntext_pdf\nscan_pdf","default":"auto"},
    {"fieldname":"template_json","fieldtype":"Long Text","label":"已批准模板快照","read_only":1},
    {"fieldname":"parent_space","fieldtype":"Link","label":"创建来源空间","options":"HBOS Knowledge Space","read_only":1},
    {"fieldname":"space_admission_json","fieldtype":"Long Text","label":"空间创建授权回执","read_only":1}
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "export": 0,
      "print": 0,
      "report": 0,
      "share": 0,
      "email": 0
    }
  ],
  "allow_rename": 0,
  "index_web_pages_for_search": 0,
  "track_changes": 0
}
