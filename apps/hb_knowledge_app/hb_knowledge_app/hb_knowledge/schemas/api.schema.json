{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hbos:k1c1:api:r1.1",
  "title": "K1-A API Contract: PROPOSED ONLY",
  "description": "No API is deployed by this schema. All examples are synthetic.",
  "$defs": {
    "Context": {
      "type": "object",
      "properties": {
        "equipment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "component_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "equipment_id"
      ],
      "additionalProperties": false
    },
    "SearchRequest": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "space_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 5
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "search_mode": {
          "type": "string",
          "enum": [
            "STANDARD",
            "PRECISE"
          ],
          "default": "STANDARD"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "query": "合成校准演示",
          "space_ids": [
            "SPACE_QA_DEMO"
          ],
          "limit": 5
        }
      ]
    },
    "AskRequest": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "space_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "search_mode": {
          "type": "string",
          "enum": [
            "STANDARD",
            "PRECISE"
          ],
          "default": "STANDARD"
        }
      },
      "required": [
        "question"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "question": "合成演示有哪些已授权依据？",
          "space_ids": [
            "SPACE_QA_DEMO"
          ]
        }
      ]
    },
    "EvidenceRequest": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "evidence_id"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "evidence_id": "evidence-demo-reference"
        }
      ]
    },
    "SpacesRequest": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false,
      "examples": [
        {}
      ]
    },
    "EvidenceCard": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "status_note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 320
        },
        "section": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "page_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100000
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "space_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "source_type": {
          "enum": [
            "COMPANY_CONTROLLED",
            "EXTERNAL_REFERENCE",
            "ORDINARY_INTERNAL_KNOWLEDGE",
            "SYNTHETIC_TEST"
          ]
        },
        "document_number": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        }
      },
      "required": [
        "document_id",
        "title",
        "version",
        "status_note",
        "section",
        "page_number",
        "excerpt",
        "evidence_id",
        "space_id",
        "source_type"
      ],
      "additionalProperties": false
    },
    "CitationCard": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "status_note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 320
        },
        "section": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "page_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100000
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "space_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "source_type": {
          "enum": [
            "COMPANY_CONTROLLED",
            "EXTERNAL_REFERENCE",
            "ORDINARY_INTERNAL_KNOWLEDGE",
            "SYNTHETIC_TEST"
          ]
        },
        "citation_label": {
          "type": "string",
          "pattern": "^C[1-5]$"
        },
        "document_number": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        }
      },
      "required": [
        "document_id",
        "title",
        "version",
        "status_note",
        "section",
        "page_number",
        "excerpt",
        "evidence_id",
        "space_id",
        "source_type",
        "citation_label"
      ],
      "additionalProperties": false
    },
    "SearchData": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mode": {
          "const": "retrieval"
        },
        "context": {
          "type": "object",
          "properties": {
            "equipment_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            "asset_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "component_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "equipment_id"
          ],
          "additionalProperties": false
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceCard"
          },
          "maxItems": 5
        },
        "search_mode": {
          "type": "string",
          "enum": [
            "STANDARD",
            "PRECISE"
          ],
          "default": "STANDARD"
        }
      },
      "required": [
        "request_id",
        "mode",
        "results"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "request_id": "req-demo-search-1",
          "mode": "retrieval",
          "results": [
            {
              "document_id": "DOC_QA_DEMO",
              "title": "合成校准参考卡",
              "version": "demo-v1",
              "status_note": "合成测试资料，非公司正式程序",
              "section": "检查点",
              "page_number": null,
              "excerpt": "此处仅为合成示例摘录。",
              "evidence_id": "evidence-demo-reference",
              "space_id": "SPACE_QA_DEMO",
              "source_type": "SYNTHETIC_TEST"
            }
          ]
        }
      ]
    },
    "AskData": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "turn_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mode": {
          "enum": [
            "authorized_generation",
            "reference_only",
            "synthetic_test",
            "internal_reference_generation"
          ]
        },
        "answer_status": {
          "enum": [
            "ANSWERED",
            "INSUFFICIENT_EVIDENCE",
            "REFERENCE_ONLY",
            "SYNTHETIC_TEST",
            "REFERENCE_ANSWERED"
          ]
        },
        "answerable": {
          "type": "boolean"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CitationCard"
          },
          "maxItems": 5
        }
      },
      "required": [
        "request_id",
        "turn_id",
        "mode",
        "answer_status",
        "answerable",
        "answer",
        "citations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "answer_status": {
                "const": "ANSWERED"
              }
            },
            "required": [
              "answer_status"
            ]
          },
          "then": {
            "properties": {
              "citations": {
                "minItems": 1,
                "maxItems": 5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_status": {
                "const": "INSUFFICIENT_EVIDENCE"
              }
            },
            "required": [
              "answer_status"
            ]
          },
          "then": {
            "properties": {
              "citations": {
                "minItems": 0,
                "maxItems": 0
              },
              "answer": {
                "const": "当前授权资料不足以形成回答。"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_status": {
                "const": "REFERENCE_ONLY"
              }
            },
            "required": [
              "answer_status"
            ]
          },
          "then": {
            "properties": {
              "citations": {
                "minItems": 1,
                "maxItems": 5
              },
              "answer": {
                "const": "仅供参考，请核对获准依据。"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_status": {
                "const": "SYNTHETIC_TEST"
              }
            },
            "required": [
              "answer_status"
            ]
          },
          "then": {
            "properties": {
              "citations": {
                "minItems": 0,
                "maxItems": 0
              },
              "answer": {
                "const": "SYNTHETIC_ONLY：仅供隔离测试。"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_status": {
                "const": "REFERENCE_ANSWERED"
              }
            },
            "required": [
              "answer_status"
            ]
          },
          "then": {
            "properties": {
              "citations": {
                "minItems": 1,
                "maxItems": 5
              }
            }
          }
        }
      ],
      "examples": [
        {
          "request_id": "req-demo-ask-1",
          "conversation_id": "conversation-demo-reference",
          "turn_id": "turn-demo-reference",
          "mode": "authorized_generation",
          "answer_status": "INSUFFICIENT_EVIDENCE",
          "answerable": false,
          "answer": "当前授权资料不足以形成回答。",
          "citations": []
        }
      ],
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "authorized_generation"
            },
            "answer_status": {
              "const": "ANSWERED"
            },
            "answerable": {
              "const": true
            }
          },
          "required": [
            "mode",
            "answer_status",
            "answerable"
          ]
        },
        {
          "properties": {
            "mode": {
              "const": "authorized_generation"
            },
            "answer_status": {
              "const": "INSUFFICIENT_EVIDENCE"
            },
            "answerable": {
              "const": false
            }
          },
          "required": [
            "mode",
            "answer_status",
            "answerable"
          ]
        },
        {
          "properties": {
            "mode": {
              "const": "reference_only"
            },
            "answer_status": {
              "const": "REFERENCE_ONLY"
            },
            "answerable": {
              "const": false
            }
          },
          "required": [
            "mode",
            "answer_status",
            "answerable"
          ]
        },
        {
          "properties": {
            "mode": {
              "const": "synthetic_test"
            },
            "answer_status": {
              "const": "SYNTHETIC_TEST"
            },
            "answerable": {
              "const": false
            }
          },
          "required": [
            "mode",
            "answer_status",
            "answerable"
          ]
        },
        {
          "properties": {
            "mode": {
              "const": "internal_reference_generation"
            },
            "answer_status": {
              "const": "REFERENCE_ANSWERED"
            },
            "answerable": {
              "const": true
            }
          },
          "required": [
            "mode",
            "answer_status",
            "answerable"
          ]
        }
      ]
    },
    "SpaceCard": {
