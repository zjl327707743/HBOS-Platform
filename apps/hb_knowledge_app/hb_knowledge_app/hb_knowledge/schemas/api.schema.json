        }
      },
      "required": [
        "ok",
        "error"
      ],
      "additionalProperties": false
    },
    "InternalDecisionRequest": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "k1c1-r1.1"
        },
        "operation": {
          "enum": [
            "introspect",
            "revalidate",
            "authorize-evidence"
          ]
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "enum": [
            "knowledge.search",
            "knowledge.evidence",
            "knowledge.spaces"
          ]
        },
        "phase": {
          "enum": [
            "introspect",
            "pre_retrieval",
            "post_retrieval",
            "pre_projection",
            "cache_read",
            "pre_issue",
            "evidence_read",
            "document_read",
            "final_publish"
          ]
        },
        "request_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time"
        },
        "references": {
          "type": "array",
