        "document_ids",
        "limit",
        "request_id",
        "decision_ref",
        "contract_version",
        "request_fingerprint",
        "plan_digest",
        "deadline_at"
      ],
      "additionalProperties": false
    },
    "InternalAsk": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "conversation_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
