    "SearchResponse": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "$ref": "#/$defs/SearchData"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    "AskResponse": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "$ref": "#/$defs/AskData"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    "EvidenceResponse": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "$ref": "#/$defs/EvidenceCard"
