          "maxLength": 320
        },
        "policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "dataset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "document_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "contract_version": {
          "const": "k1c1-r1.1"
        },
        "request_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time"
        },
        "space_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        },
        "search_mode": {
          "type": "string",
          "enum": [
