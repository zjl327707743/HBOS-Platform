+const accountGateReady = ref(false)
+const managementPath = ref<string | null>(null)
+const managementError = ref<string | null>(null)
+let managementGeneration = 0
+
+async function loadManagementEntry() {
+  const generation = ++managementGeneration
+  const subject = portal.user?.id
+  managementPath.value = null
+  managementError.value = null
+  if (sessionPending.value || !subject || !accountGateReady.value) return
+  try {
+    // This service is a future same-origin session endpoint, never localStorage
+    // or a frontend Role/Admin check. Unknown capability data hides the entry.
+    const access = await fetchIamCapabilities()
+    if (generation !== managementGeneration || portal.user?.id !== subject) return
+    managementPath.value = IAM_ADMIN_PAGES.some(page => access.capabilities.includes(page.capability))
+      ? '/hbos/admin'
+      : null
+  } catch (error) {
+    if (generation !== managementGeneration || portal.user?.id !== subject) return
+    if (!isUnauthenticatedError(error)) managementError.value = '管理能力检查暂不可用，请重试。'
+  }
+}
+
+// Bootstrap refresh replaces portal.user, including focus/session refresh.
+// Clear the entry before each refresh and reject a late response from an old user.
+watch(() => portal.user?.id, () => { accountGateReady.value = false }, { flush: 'sync' })
+watch([sessionPending, () => portal.user, accountGateReady], () => { void loadManagementEntry() }, { immediate: true })

