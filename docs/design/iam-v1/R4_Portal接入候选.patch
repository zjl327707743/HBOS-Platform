+// Design candidate: page guards only shape navigation. Every backend operation
+// must independently authorize the current session, target and requested scope.
+router.beforeEach(async (to) => {
+  if (!to.matched.some(record => record.meta.requiresIamAccess)) return true
+  try {
+    const access = await fetchIamCapabilities()
+    const available = IAM_ADMIN_PAGES.filter(page => access.capabilities.includes(page.capability))
+    if (!available.length) return { path: '/hbos/403', query: { app: 'iam' } }
+    if (to.name === 'iam-admin') return available[0].path
+    const required = to.meta.iamCapability
+    if (typeof required !== 'string' || !access.capabilities.includes(required)) {
+      return { path: '/hbos/403', query: { app: 'iam' } }
+    }
+    return true
+  } catch (error) {
+    if (isUnauthenticatedError(error)) {
+      return { path: '/hbos/login', query: { status: 'session_required', redirect_to: accountRedirect(to.fullPath) } }
+    }
+    if (error instanceof FrappeRequestError && error.code === 'FORBIDDEN') {
+      return { path: '/hbos/403', query: { app: 'iam' } }
+    }
+    return { name: 'iam-access-unavailable', query: { redirect_to: accountRedirect(to.fullPath) } }
+  }
+})
+
 router.afterEach((to) => {
