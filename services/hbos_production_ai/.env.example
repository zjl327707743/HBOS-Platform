# AI 工艺分析服务 —— 本地运行配置（**不入库**）
#
# 本服务有**自己的** .env（Owner 2026-10-02 选 B），
# 与仓库根 .env 的 HBOS_AI_*（考勤模块用）不共用 —— 两者互不影响。
#
# 手动跑：
#   cd services/hbos_production_ai
#   uv run --env-file .env python -m app.main

# ---- 模型（OpenAI 兼容端点）----
# HBOS_AI_ENABLED=0 时不分析，直接退出（默认关，防止误跑花 token）
HBOS_AI_ENABLED=1
HBOS_AI_BASE_URL=https://model-ref.joincare.com.cn/v1
HBOS_AI_API_KEY=
# 模型名不要猜 —— 改成上游真实存在的名字后先探活
# （历史上 deepseek-v4-flash 被下游下线后跑了整批才失败）
HBOS_AI_MODEL=gpt-5.6-sol
HBOS_AI_TIMEOUT=180
HBOS_AI_RETRIES=2

# ---- 飞书（读工艺描述 + 台账；写 AI 结果表）----
# 结果表是 Dl45bIEEya78fWsL4DXcwuJtn8c / tblXD7oAwbU8U040，
# 所以这个应用对该 Base 需要**写**权限（与只读的取数服务不同）。
HBOS_FEISHU_APP_ID=
HBOS_FEISHU_APP_SECRET=
HBOS_FEISHU_TIMEOUT=30

# ---- 分析范围 ----
# 分析范围：逗号分隔。**2026-10-10 起放开到全部 6 个在产产品**（此前只跑 4BMA 验证输出质量）。
HBOS_AI_PRODUCTS=4BMA,F9,F12,F13,无菌美罗培南,无菌亚胺培南

# 喂给模型的最大台账批数（取最近的）。台账有 1200+ 行，全喂没必要。
HBOS_AI_MAX_BATCHES=30

# 只跑不写，用于验证输出质量（不污染结果表）
HBOS_AI_DRY_RUN=0

HBOS_AI_LOG_LEVEL=INFO
