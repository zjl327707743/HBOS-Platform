# 生产看板取数服务——本地运行配置（**不入库**，含飞书凭据）
#
# 启动：
#   uv run --env-file .env uvicorn app.main:app --host 127.0.0.1 --port 8101
#
# ⚠️ 这里的 app_secret 是**唯一**持有飞书凭据的地方。
#    绝不能把它放到前端（VITE_* 前缀的变量会被打进前端产物，等于公开）。

# 飞书自建应用凭据（与既有考勤同步脚本用同一套应用即可）
HBOS_FEISHU_APP_ID=
HBOS_FEISHU_APP_SECRET=

# 监听地址与端口。8100 已被 hbos_ocr 占用。
HBOS_PRODUCTION_HOST=127.0.0.1
HBOS_PRODUCTION_PORT=8101

# 上游请求超时（秒）
HBOS_PRODUCTION_TIMEOUT=30

# 结果缓存秒数（进程内，非持久）
HBOS_PRODUCTION_CACHE_TTL=300

HBOS_PRODUCTION_LOG_LEVEL=INFO

# 允许跨源的前端源（逗号分隔）。
# 开发默认放本机 Vite 端口；**部署到服务器时必须改成看板的实际域名**，
# 否则浏览器的 CORS 会拦掉请求。
# 例：HBOS_PRODUCTION_CORS_ORIGINS=https://hbos.example.com
HBOS_PRODUCTION_CORS_ORIGINS=http://127.0.0.1:5178,http://127.0.0.1:5179,http://localhost:5178,http://localhost:5179
