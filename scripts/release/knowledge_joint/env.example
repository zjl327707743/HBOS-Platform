# Replace image digests with the reviewed architecture-specific lock. This
# example is linux/arm64; linux/amd64 remains an independent build/verify gate.
COMPOSE_PROJECT_NAME=hbos-uat2-smoke-rehearsal
HBOS_SITE=uat2-smoke-rehearsal.localhost
HBOS_PORTAL_ORIGIN=http://uat2-smoke-rehearsal.localhost:18460
HBOS_SMOKE_PORT=18460
# Review host/VPN/Docker overlap before deployment; do not prune other networks.
HBOS_NETWORK_SUBNET=10.253.42.0/24
HBOS_RELEASE_ROOT=/srv/hbos/releases/REVIEWED_RELEASE
HBOS_PRIVATE_ROOT=/srv/hbos/private/rehearsal
HBOS_UPLOAD_ROOT=/srv/hbos/private/uploads
HBOS_AUDIT_ROOT=/srv/hbos/private/audit
FRAPPE_IMAGE=frappe/erpnext@sha256:d349cceb89693d54525ef9696c29af772c05ad4f42af723742cbee4e62420583
PYTHON_IMAGE=python@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2
MARIADB_IMAGE=mariadb@sha256:efb4959ef2c835cd735dbc388eb9ad6aab0c78dd64febcd51bc17481111890c4
REDIS_IMAGE=redis@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2
NGINX_IMAGE=nginxinc/nginx-unprivileged@sha256:65e3e85dbaed8ba248841d9d58a899b6197106c23cb0ff1a132b7bfe0547e4c0
