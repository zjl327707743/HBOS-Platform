# Copy to a protected server-only file; do not commit actual values.
HBOS_DOMAIN=portal.example.invalid
HBOS_SITE=existing-site
HBOS_FRAPPE_UPSTREAM=127.0.0.1:8080
HBOS_TLS_CERT=/etc/hbos/tls/fullchain.pem
HBOS_TLS_KEY=/etc/hbos/tls/privkey.pem
HBOS_GATEWAY_TOKEN_FILE=/run/hbos-private/gateway_token
HBOS_GATEWAY_POLICY_PATH=/run/hbos-private/gateway_policy.json
HBOS_GATEWAY_LOCAL_INDEX_PATH=/run/hbos-private/index.jsonl
HBOS_GATEWAY_CLIENT_ID=hbos-frappe

HBOS_RELEASE_ROOT=/opt/hbos/releases/REVIEWED_COMMIT
HBOS_GATEWAY_BUILD_CONTEXT=/opt/hbos/checkouts/REVIEWED_COMMIT
HBOS_PRIVATE_GATEWAY_ROOT=/srv/hbos-private/gateway
HBOS_PRIVATE_MODEL_ROOT=/srv/hbos-private/models
HBOS_PRIVATE_AUDIT_ROOT=/srv/hbos-private/release-audit
HBOS_GATEWAY_UID=1000
HBOS_GATEWAY_GID=1000
