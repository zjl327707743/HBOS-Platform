COMPOSE_PROJECT_NAME=hbos-m0-r3a

# Official reference tag from frappe/frappe_docker pwd.yml at 2026-07-06.
ERPNEXT_VERSION=v16.26.2

# Local test site. Keep FRAPPE_SITE_NAME_HEADER aligned with SITE_NAME for localhost access.
SITE_NAME=frontend
FRAPPE_SITE_NAME_HEADER=frontend
HTTP_PORT=8080

# Database. Use local-only values in .env; do not commit real secrets.
MARIADB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=<LOCAL_DB_ROOT_PASSWORD>
MYSQL_ROOT_PASSWORD=<LOCAL_DB_ROOT_PASSWORD>

# Redis service names inside the Compose network.
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
SOCKETIO_PORT=9000

# Frappe administrator password for the local test site.
ADMIN_PASSWORD=<LOCAL_ADMIN_PASSWORD>

# Nginx/frontend proxy defaults.
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# ── 应用侧配置 ──────────────────────────────────────────────────────────
# 以下变量被 docker-compose.yml 引用。compose 的 ${VAR} 在 .env 缺项时展开为
# 空字符串、不报错，所以漏配不会启动失败，只会让对应功能静默失效——必须在
# 此处列全，新环境照本文件建 .env 才不会缺。
# 真实值只写进本地 .env（已被 .gitignore 忽略），本文件只放占位符。

# 外部系统真实同步默认关闭；生产环境经 Owner/管理员确认后再显式设为 1。
HBOS_FEISHU_SYNC_ENABLED=0
HBOS_DELICLOUD_SYNC_ENABLED=0

# 飞书自建应用（请假/加班/调休多维表格同步）
FEISHU_APP_ID=<FEISHU_APP_ID>
FEISHU_APP_SECRET=<FEISHU_APP_SECRET>
HBOS_FEISHU_LEAVE_APP_TOKEN=<HBOS_FEISHU_LEAVE_APP_TOKEN>
HBOS_FEISHU_LEAVE_TABLE_ID=<HBOS_FEISHU_LEAVE_TABLE_ID>
HBOS_FEISHU_OVERTIME_APP_TOKEN=<HBOS_FEISHU_OVERTIME_APP_TOKEN>
HBOS_FEISHU_OVERTIME_TABLE_ID=<HBOS_FEISHU_OVERTIME_TABLE_ID>
HBOS_FEISHU_REST_LEAVE_APP_TOKEN=<HBOS_FEISHU_REST_LEAVE_APP_TOKEN>
HBOS_FEISHU_REST_LEAVE_TABLE_ID=<HBOS_FEISHU_REST_LEAVE_TABLE_ID>
HBOS_FEISHU_EXCEPTION_APP_TOKEN=<HBOS_FEISHU_EXCEPTION_APP_TOKEN>
HBOS_FEISHU_EXCEPTION_TABLE_ID=<HBOS_FEISHU_EXCEPTION_TABLE_ID>

# 得力云考勤机（打卡流水同步）
DELICLOUD_APP_KEY=<DELICLOUD_APP_KEY>
DELICLOUD_APP_SECRET=<DELICLOUD_APP_SECRET>

# LLM（月度汇总 AI 复核 + 调休「说明」提取加班日）。OpenAI 兼容协议。
# 默认关闭；若调休说明等请求会携带身份信息，还需单独显式允许 PII 出站。
HBOS_AI_ENABLED=0
HBOS_AI_ALLOW_PII=0
HBOS_AI_BASE_URL=<HBOS_AI_BASE_URL>
HBOS_AI_API_KEY=<HBOS_AI_API_KEY>
HBOS_AI_MODEL=<HBOS_AI_MODEL>
HBOS_AI_TIMEOUT=60

# 考勤到岗卡片（每日 09:00 发往飞书群机器人 webhook）。
# WEBHOOK_URL 为空时 send_daily_report 只写 Error Log 并返回
# {"sent": false, "reason": "no_webhook"}，群里收不到任何消息。
HBOS_NOTIFY_WEBHOOK_URL=<HBOS_NOTIFY_WEBHOOK_URL>
# 设为 1 时只渲染并留档报文、不真正发送（版式核对用）。
HBOS_NOTIFY_DRY_RUN=

# HBOS Inventory local OCR service. Keep the token private and identical on Frappe + OCR host.
HBOS_OCR_URL=http://host.docker.internal:8100
HBOS_OCR_SHARED_TOKEN=<LOCAL_RANDOM_OCR_SHARED_TOKEN>
